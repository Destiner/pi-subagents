{
  "name": "@destiner/pi-subagents",
  "version": "0.1.2",
  "description": "Subagents for pi: delegate by intelligence level, and let your settings decide which model runs it",
  "type": "module",
  "license": "MIT",
  "author": "Timur Badretdinov (https://github.com/Destiner)",
  "homepage": "https://github.com/Destiner/pi-subagents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Destiner/pi-subagents.git"
  },
  "bugs": {
    "url": "https://github.com/Destiner/pi-subagents/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagent",
    "agent",
    "delegation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "config.ts",
    "runner.ts",
    "status.ts",
    "types.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "typebox": "^1.3.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^24.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
